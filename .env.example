# Copy this file to .env and fill values locally. .env is ignored by Git.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
ACCOUNT_KEY_PEPPER=
BROWSER_SESSION_SECRET=
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:8000
API_DOCS_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
ADMIN_EMAILS=
ALLOW_REPEAT_PARTICIPATION=false

PROLIFIC_MODE_ENABLED=true
# Required when PROLIFIC_MODE_ENABLED=true. Comma-separate multiple study IDs.
PROLIFIC_ALLOWED_STUDY_IDS=
PROLIFIC_COMPLETION_CODE=
PROLIFIC_COMPLETION_URL=
PROLIFIC_INTEGRATION_URL=http://localhost:8000/
# Keep disabled for development, integration, and deployment acceptance tests.
PROLIFIC_DYNAMIC_PAYMENT_ENABLED=false

# Use Connect -> Session pooler -> URI (port 5432) for IPv4 compatibility.
SUPABASE_DB_URL=

RUN_SUPABASE_INTEGRATION=1
SUPABASE_INTEGRATION_ALLOW_SYNTHETIC_WRITES=1

# The integration harness excludes Prolific credentials and uses a fake processor.
PROLIFIC_API_TOKEN=
